<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kofre.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No web pages: no static web assets file to publish. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- MailKit (MimeKit) asks for 10.0.0, which has known vulnerabilities: the patched one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kofre.Server.Tests" />
  </ItemGroup>

</Project>
