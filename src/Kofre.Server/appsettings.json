{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kofre": {
    "DataFolder": "data",
    "SigningKey": "",
    "TrashDays": 30,
    "MaxUploadBytes": 4294967296,
    "MaxPendingAccounts": 10,
    "SignInsPerMinute": 10,
    "Logs": {
      "Folder": "logs",
      "MaxFiles": 5,
      "MaxFileBytes": 10485760,
      "MemoryEntries": 1000
    },
    "Backup": {
      "Enabled": true,
      "Folder": "backups",
      "Time": "03:00",
      "ConfigFiles": [ "appsettings.json" ],
      "KeepDaily": 7,
      "KeepWeekly": 4,
      "KeepMonthly": 12
    },
    "Email": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "User": "",
      "From": "",
      "To": "",
      "SummaryTime": "07:00"
    }
  }
}
